# ==============================================================================
# Sugie Bot Environment Variables Template (.env.example)
# Only sensitive keys, tokens, and secrets should be stored in this file.
# Non-sensitive settings (channels, streams, repo filters, rules) are in sugie.toml.
# ==============================================================================

# Tracing / Logging Level
RUST_LOG=info,sugie=debug

# ------------------------------------------------------------------------------
# GitHub App Authentication
# ------------------------------------------------------------------------------
SUGIE_GITHUB_APP_ID=123456
# Required. Deliveries are rejected with 503 while this is empty — HMAC would
# otherwise be verifiable with a zero-length key, which anyone can compute.
# Must match the "Webhook secret" configured on the GitHub App.
SUGIE_GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
SUGIE_GITHUB_PRIVATE_KEY_PATH=sugie.private-key.pem
# Alternatively, set the RSA private key PEM string directly:
# SUGIE_GITHUB_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# Outbound Notification Webhook URLs & API Keys
# ------------------------------------------------------------------------------
# Discord: either a bot token (one credential, any channel the bot can post in)
# or a channel webhook (one URL per channel). The token wins when both are set.
# SUGIE_DISCORD_BOT_TOKEN=your-discord-bot-token
# SUGIE_DISCORD_CHANNEL_ID=123456789012345678
# SUGIE_DISCORD_REPORTS_CHANNEL_ID=123456789012345678
SUGIE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/main/webhook

# Multiple named webhook channels in .env (add as many as you need):
# SUGIE_DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/123/alerts-token
# SUGIE_DISCORD_WEBHOOK_RELEASES=https://discord.com/api/webhooks/456/releases-token
# Or comma-separated: SUGIE_DISCORD_WEBHOOKS="alerts=https://...,releases=https://..."

# Multiple named bot channels in .env:
# SUGIE_DISCORD_BOT_CHANNEL_GENERAL=1566409794317844480
# SUGIE_DISCORD_BOT_CHANNEL_DEV=156640979431784439
# Or comma-separated: SUGIE_DISCORD_BOT_CHANNELS="general=1566409794317844480,dev=156640979431784439"
SUGIE_ZULIP_BOT_API_KEY=your-zulip-bot-api-key
# Default channel (or stream):
# SUGIE_ZULIP_CHANNEL=general
# Multiple named channel + topic destinations in .env (add as many as you need):
# SUGIE_ZULIP_CHANNEL_ALERTS="alerts:urgent"
# SUGIE_ZULIP_CHANNEL_GENERAL="general:announcements"
# Or comma-separated: SUGIE_ZULIP_CHANNELS="alerts=alerts:urgent,general=general:announcements"
# Lark (Feishu):
# Option A: Lark Bot App (Recommended - single bot to send & receive across multiple channels)
# SUGIE_LARK_APP_ID=cli_a1b2c3d4e5f6g7h8
# SUGIE_LARK_APP_SECRET=your-lark-app-secret
# SUGIE_LARK_DEFAULT_CHAT_ID=oc_a0553eda9014c201e6969b478895c230
# SUGIE_LARK_API_BASE=https://open.larksuite.com # or https://open.feishu.cn for Feishu

# Option B: Lark Custom Robot Webhook (Legacy single group chat)
SUGIE_LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/your-hook-uuid
SUGIE_LARK_SignatureVerification=your-lark-secret

# ------------------------------------------------------------------------------
# Inbound Chat Webhook Verification Tokens (Bot-to-Server messaging)
# ------------------------------------------------------------------------------
# Each platform verifies with its own credential — SUGIE_CHAT_API_TOKEN does NOT
# cover these routes. Left unset, the matching endpoint accepts unverified
# requests and the service warns about it at startup.
# SUGIE_ZULIP_OUTGOING_TOKEN=your-zulip-outgoing-webhook-token
# SUGIE_LARK_VERIFICATION_TOKEN=your-lark-verification-token
# Only needed when the Lark app is configured with an Encrypt Key; encrypted
# callbacks are rejected without it.
# SUGIE_LARK_ENCRYPT_KEY=your-lark-encrypt-key
# SUGIE_DISCORD_PUBLIC_KEY=your-discord-app-public-key

# ------------------------------------------------------------------------------
# Generic Chat Bridge API (POST /api/chat/command)
# ------------------------------------------------------------------------------
# That endpoint can run /comment, /assign, /close and every other chat command.
# Set a shared secret here to require the X-Sugie-Chat-Token header on every call
# (generate one with `openssl rand -hex 32`). Left unset, the endpoint stays open
# and the service warns about it at startup.
# SUGIE_CHAT_API_TOKEN=your-long-random-shared-secret

# ------------------------------------------------------------------------------
# WebAuthn (Passkey / FIDO2) & OTP Relying Party Configuration
# ------------------------------------------------------------------------------
SUGIE_WEBAUTHN_RP_ID=localhost
SUGIE_WEBAUTHN_RP_ORIGIN=http://localhost:8800
SUGIE_WEBAUTHN_RP_NAME="Sugie Admin"
