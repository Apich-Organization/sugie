# ==============================================================================
# Sugie Bot Environment Variables Template (.env.example)
# ==============================================================================

# Server & Network Configuration
SUGIE_HOST=0.0.0.0
SUGIE_PORT=8800
SUGIE_DATA_DIR=./data
SUGIE_DB_PATH=data/sugie.db

# Tracing / Logging Level
RUST_LOG=info,sugie=debug

# GitHub App Authentication
SUGIE_GITHUB_APP_ID=123456
SUGIE_GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
SUGIE_GITHUB_PRIVATE_KEY_PATH=sugie.private-key.pem

# ------------------------------------------------------------------------------
# Notification Channels (Discord, Zulip, Lark)
# ------------------------------------------------------------------------------
SUGIE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SUGIE_ZULIP_SITE_URL=https://your-org.zulipchat.com
SUGIE_ZULIP_BOT_EMAIL=bot@your-org.zulipchat.com
SUGIE_ZULIP_BOT_API_KEY=your-api-key
SUGIE_ZULIP_STREAM=general
SUGIE_LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/...
SUGIE_LARK_SignatureVerification=your-lark-secret

# ------------------------------------------------------------------------------
# Repository Notification Filters (Comma-separated list of allowed repositories)
# ------------------------------------------------------------------------------
# Global filter (applies across Discord, Zulip, and Lark unless overridden per-channel)
# If left commented or "*", all onboarded repositories send notifications.
# SUGIE_NOTIFICATION_REPOSITORIES=StarLabsSI/ensia,StarLabsSI/bincode

# Per-channel filters (overrides global filter for that specific platform):
# SUGIE_DISCORD_REPOSITORIES=StarLabsSI/ensia
# SUGIE_ZULIP_REPOSITORIES=StarLabsSI/ensia,StarLabsSI/bincode
# SUGIE_LARK_REPOSITORIES=StarLabsSI/ensia

# ------------------------------------------------------------------------------
# Super Users & Restricted Commands
# ------------------------------------------------------------------------------
# Comma-separated list of GitHub usernames with elevated privileges:
# SUGIE_SUPER_USERS=alice,bob,cn-starlabs

# Comma-separated list of commands that ONLY super users can execute:
# Available commands: close, reopen, move, duplicate, project, retest, label, unlabel, assign, unassign
# SUGIE_RESTRICTED_COMMANDS=close,reopen,move,duplicate,project,retest
