# Sugie Bot Environment Variables Template

SUGIE_HOST=0.0.0.0
SUGIE_PORT=8080
SUGIE_DB_PATH=sugie.db

# GitHub App Authentication
SUGIE_GITHUB_APP_ID=123456
SUGIE_GITHUB_WEBHOOK_SECRET=your-webhook-secret
SUGIE_GITHUB_PRIVATE_KEY_PATH=sugie.private-key.pem
# Or inline:
# SUGIE_GITHUB_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n..."
